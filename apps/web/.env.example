# Copy to .env.local (never commit it).

# Ring access token. For development, generate one in the Ring Developer Playground:
#   https://developer.amazon.com/ring/console/playground  ->  "Generate token"
# Playground tokens expire after 30 minutes; paste a fresh one here when calls start failing with 401.
# The dev server reloads this file automatically.
RING_ACCESS_TOKEN=

# HMAC key Ring uses to sign webhooks (Ring Developer Console -> your app -> credentials).
# Leave empty in development: Herald then generates a random key per run and the simulator signs with it.
RING_WEBHOOK_SIGNING_KEY=

# What Herald calls the door in alerts, e.g. "Doorbell. Someone is at the front door."
HERALD_DOOR_LABEL=front door

# Herald's voice. With a Deepgram API key (https://console.deepgram.com), alerts are spoken in
# Deepgram's Aura-2 voice: this server synthesises each sentence once and caches it, and the key
# never reaches the browser. Leave it empty and each browser speaks with its built-in voice.
DEEPGRAM_API_KEY=

# The webhook simulator is on in development and off in production unless set to "on".
# HERALD_SIMULATOR=on

# Password for the whole app (the browser asks once; any user name works). Leave it unset on your
# own machine. Set it on any server reachable from the internet: Herald relays live video from
# your camera. Ring's webhook stays reachable because it is checked by its HMAC signature instead.
# HERALD_PASSWORD=
