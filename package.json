{
  "name": "herald",
  "private": true,
  "description": "Accessible doorbell alerts for Ring, for people who can't hear the chime or can't see the door.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:contrast": "npm run check:contrast -w apps/web"
  },
  "engines": {
    "node": ">=22.18"
  }
}
